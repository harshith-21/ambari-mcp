# Ambari Configuration
AMBARI_HOST=localhost
AMBARI_PORT=8080
AMBARI_USERNAME=admin
AMBARI_PASSWORD=admin
AMBARI_CLUSTER_NAME=MyCluster
AMBARI_USE_SSL=false

# MCP Server Configuration
MCP_SERVER_NAME=ambari-mcp
MCP_SERVER_VERSION=1.0.0
MCP_MODE=normal
MCP_HOST=0.0.0.0
MCP_PORT=8001

# FastAPI Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_DEBUG=false

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/ambari-mcp.log

# Security Configuration
API_KEY_HEADER=X-API-Key
API_KEY=your-secret-api-key-here

# Operational Modes
# normal: Standard operations
# cluster_maintenance: Maintenance mode with restricted operations
# scale_up: Optimized for scaling operations
# config_edit: Configuration management mode
# development: Development mode with enhanced logging 